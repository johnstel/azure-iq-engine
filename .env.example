# Azure AI Foundry (Azure OpenAI)
FOUNDRY_BASE_URL=https://your-endpoint.services.ai.azure.com
FOUNDRY_KEY=your-api-key

# Azure AI Search
SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_API_KEY=your-search-key

# Bing Search API (optional — for company research)
BING_API_KEY=your-bing-key

# YouTube Data API (optional — for YouTube crawler)
YOUTUBE_API_KEY=your-youtube-key

# Redis (optional — for caching)
REDIS_URL=redis://localhost:6379

# Application Insights (optional — for distributed tracing and metrics)
# Obtain from Azure Portal: Application Insights → Overview → Connection String
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=00000000-0000-0000-0000-000000000000;...

# App settings
APP_ENV=development
LOG_LEVEL=INFO
