# Azure AI Foundry (Azure OpenAI)
FOUNDRY_BASE_URL=https://your-endpoint.services.ai.azure.com
FOUNDRY_KEY=your-api-key

# Azure AI Search
SEARCH_ENDPOINT=https://your-search.search.windows.net
SEARCH_API_KEY=your-search-key

# Grounding with Bing Search (optional — for web-grounded company research)
BING_GROUNDING_ENDPOINT=https://api.bing.microsoft.com/v7.0
BING_GROUNDING_KEY=your-bing-grounding-key
# Optional: Foundry connection ID for agent-native integration
# BING_GROUNDING_CONNECTION_ID=/subscriptions/.../connections/bing-grounding

# YouTube Data API (optional — for YouTube crawler)
YOUTUBE_API_KEY=your-youtube-key

# Redis (optional — for caching)
REDIS_URL=redis://localhost:6379

# App settings
APP_ENV=development
LOG_LEVEL=INFO
